{
  "ignore": [
    "app/dist-test/**",
    "app/dist/**",
    "app/src-tauri/gen/**",
    "app/src/features/page/paste/fixtures/**",
    "tests/fixtures/clipboard/**",
    "app/src/platform/bindings/*.ts",
    "app/src/theme/tokens.css",
    "app/src/theme/tokens.ts",
    "crates/interop/tests/corpus/*/**",
    "THIRD_PARTY_NOTICES.md",
    "target/**",
    "crates/interop/tests/data/legacy/**",
    "extensions/clipper/shared/vendor/**",
    "app/src-tauri/src/intel/catalog.rs",
    "app/src/services/intel/packs.ts",
    "crates/intel-engines/tests/fixtures/**",
    "app/src/features/ink/pens/golden/*.txt",
    "crates/third_party/**",
    "app/src/theme/fonts/**",
    "crates/*/fuzz/regressions/**",
    "tests/ui/docscap/**"
  ],
  "rules": {
    "spelling": {
      "allow": []
    },
    "readability": {
      "grade": {
        "warn": 12,
        "error": 16
      },
      "minSectionWords": 80,
      "allowAcronyms": [
        "CHECKS",
        "GTK",
        "ONNX",
        "NNAPI",
        "WASAPI",
        "ISF",
        "ML",
        "MLX",
        "MSIX",
        "NSIS",
        "SHA"
      ]
    },
    "length": {
      "sentenceWords": {
        "warn": 30,
        "error": 45
      },
      "paragraphWords": {
        "warn": 90,
        "error": 150
      },
      "sectionWords": {
        "warn": 400,
        "error": 700
      },
      "codeLineChars": {
        "warn": 120,
        "error": 140
      }
    },
    "modifiability": {
      "fileLines": {
        "warn": 400,
        "error": 800
      },
      "functionLines": {
        "warn": 50,
        "error": 100
      },
      "nestingDepth": {
        "warn": 4,
        "error": 6
      },
      "parameters": {
        "warn": 5,
        "error": 8
      },
      "duplicateBlockLines": 8
    },
    "usability": {
      "tocMinWords": 1500,
      "exclude": [
        ".github/**"
      ]
    },
    "brand-consistency": {
      "include": [
        "app/src/**/*.{ts,tsx,css,scss}"
      ],
      "tokenFiles": [
        "app/src/theme/tokens.{css,ts}",
        "brand/**"
      ],
      "maxDurationMs": 400
    },
    "brand-tokens": {
      "maxDurationMs": 400
    },
    "accent-roles": {
      "candle": [
        "app/src/features/theme/ThemeToggle.module.css"
      ],
      "ambient": [
        "app/src/shell/layout/Workspace.module.css",
        "app/src/features/setup/SetupView.module.css"
      ],
      "pens": [
        "app/src/features/tree/Tree.module.css",
        "app/src/shell/layout/Rail.tsx",
        "app/src/shell/titlebar/TitleBar.module.css",
        "app/src/features/setup/steps/ColorChips.tsx",
        "app/src/theme/appearance.css",
        "app/src/features/qol/TabStrip.module.css",
        "app/src/features/page/PageView.module.css",
        "app/src/features/page/title/title.module.css"
      ]
    },
    "logical-properties": {
      "include": [
        "app/src/**/*.{css,scss,tsx}"
      ]
    },
    "ui-voice": {
      "include": [
        "app/src/strings/en/**/*.ts"
      ]
    }
  }
}
