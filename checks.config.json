{
  "ignore": [
    "app/dist-test/**",
    "app/dist/**",
    "app/src-tauri/gen/**",
    "app/src/features/editor/paste/fixtures/**",
    "app/src/platform/bindings/*.ts",
    "app/src/theme/tokens.css",
    "app/src/theme/tokens.ts",
    "target/**"
  ],
  "rules": {
    "spelling": {
      "allow": []
    },
    "readability": {
      "grade": {
        "warn": 12,
        "error": 16
      },
      "minSectionWords": 80,
      "allowAcronyms": [
        "CHECKS",
        "GTK",
        "ONNX",
        "NNAPI",
        "WASAPI",
        "ISF",
        "ML",
        "MLX",
        "MSIX",
        "NSIS",
        "SHA"
      ]
    },
    "length": {
      "sentenceWords": {
        "warn": 30,
        "error": 45
      },
      "paragraphWords": {
        "warn": 90,
        "error": 150
      },
      "sectionWords": {
        "warn": 400,
        "error": 700
      },
      "codeLineChars": {
        "warn": 120,
        "error": 140
      }
    },
    "modifiability": {
      "fileLines": {
        "warn": 400,
        "error": 800
      },
      "functionLines": {
        "warn": 50,
        "error": 100
      },
      "nestingDepth": {
        "warn": 4,
        "error": 6
      },
      "parameters": {
        "warn": 5,
        "error": 8
      },
      "duplicateBlockLines": 8
    },
    "usability": {
      "tocMinWords": 1500,
      "exclude": [
        ".github/**"
      ]
    },
    "brand-consistency": {
      "include": [
        "app/src/**/*.{ts,tsx,css,scss}"
      ],
      "tokenFiles": [
        "app/src/theme/tokens.{css,ts}",
        "brand/**"
      ],
      "maxDurationMs": 400
    },
    "brand-tokens": {
      "maxDurationMs": 400
    }
  }
}
