{
  "manifest_version": 3,
  "name": "OpenNote Web Clipper",
  "short_name": "OpenNote Clipper",
  "version": "0.1.0",
  "description": "Save a web page, a clean article, a region of the screen, or a Gmail message to OpenNote on this PC.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-32.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Clip to OpenNote",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-32.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["https://mail.google.com/*", "https://mail-attachment.googleusercontent.com/*"],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+O" }, "description": "Open the clipper" }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:* https://mail.google.com https://mail-attachment.googleusercontent.com; img-src 'self' data:"
  }
}
