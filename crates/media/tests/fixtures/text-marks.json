{
  "note": "Cases for TextMarks, shared by the Rust tests (tests/shared_fixtures.rs) and the TypeScript ones (app/src/core/audio/stamps.test.ts). A type step expands into one edit for each character: count characters from at, each everyMs after the last, starting at startMs. Marks are [from, to, recording, startNs, endNs].",
  "cases": [
    {
      "name": "typing in a row makes one mark",
      "steps": [{ "type": { "at": 0, "count": 5, "startMs": 1000, "everyMs": 100, "recording": "r1" } }],
      "recordings": ["r1"],
      "marks": [[0, 5, 0, 1000000000, 1400000000]],
      "timeAt": [
        [0, "r1", 1000000000],
        [2, "r1", 1200000000],
        [4, "r1", 1400000000],
        [5, null, null]
      ]
    },
    {
      "name": "a pause in typing starts a new mark",
      "steps": [
        { "type": { "at": 0, "count": 3, "startMs": 1000, "everyMs": 100, "recording": "r1" } },
        { "type": { "at": 3, "count": 3, "startMs": 5000, "everyMs": 100, "recording": "r1" } }
      ],
      "recordings": ["r1"],
      "marks": [
        [0, 3, 0, 1000000000, 1200000000],
        [3, 6, 0, 5000000000, 5200000000]
      ],
      "timeAt": [
        [1, "r1", 1100000000],
        [4, "r1", 5100000000]
      ]
    },
    {
      "name": "typing before a mark moves it",
      "steps": [
        { "type": { "at": 0, "count": 5, "startMs": 1000, "everyMs": 100, "recording": "r1" } },
        { "edit": { "at": 0, "deleted": 0, "inserted": 3 } }
      ],
      "recordings": ["r1"],
      "marks": [[3, 8, 0, 1000000000, 1400000000]],
      "timeAt": [
        [1, null, null],
        [3, "r1", 1000000000]
      ]
    },
    {
      "name": "text typed inside a mark splits it",
      "steps": [
        { "type": { "at": 0, "count": 5, "startMs": 1000, "everyMs": 100, "recording": "r1" } },
        { "edit": { "at": 2, "deleted": 0, "inserted": 3, "stamp": { "recording": "r1", "captureMs": 9000 } } }
      ],
      "recordings": ["r1"],
      "marks": [
        [0, 2, 0, 1000000000, 1100000000],
        [2, 5, 0, 9000000000, 9000000000],
        [5, 8, 0, 1200000000, 1400000000]
      ],
      "timeAt": [
        [3, "r1", 9000000000],
        [6, "r1", 1300000000]
      ]
    },
    {
      "name": "deleting the middle of a mark keeps both ends",
      "steps": [
        { "type": { "at": 0, "count": 5, "startMs": 1000, "everyMs": 100, "recording": "r1" } },
        { "edit": { "at": 1, "deleted": 3, "inserted": 0 } }
      ],
      "recordings": ["r1"],
      "marks": [
        [0, 1, 0, 1000000000, 1000000000],
        [1, 2, 0, 1400000000, 1400000000]
      ],
      "timeAt": []
    },
    {
      "name": "replacing text removes the old marks and stamps the new",
      "steps": [
        { "type": { "at": 0, "count": 6, "startMs": 1000, "everyMs": 100, "recording": "r1" } },
        { "edit": { "at": 2, "deleted": 2, "inserted": 4, "stamp": { "recording": "r1", "captureMs": 7000 } } }
      ],
      "recordings": ["r1"],
      "marks": [
        [0, 2, 0, 1000000000, 1100000000],
        [2, 6, 0, 7000000000, 7000000000],
        [6, 8, 0, 1400000000, 1500000000]
      ],
      "timeAt": []
    },
    {
      "name": "marks of two recordings stay apart",
      "steps": [
        { "edit": { "at": 0, "deleted": 0, "inserted": 2, "stamp": { "recording": "r1", "captureMs": 1000 } } },
        { "edit": { "at": 2, "deleted": 0, "inserted": 2, "stamp": { "recording": "r2", "captureMs": 1050 } } }
      ],
      "recordings": ["r1", "r2"],
      "marks": [
        [0, 2, 0, 1000000000, 1000000000],
        [2, 4, 1, 1050000000, 1050000000]
      ],
      "timeAt": [
        [1, "r1", 1000000000],
        [3, "r2", 1050000000]
      ]
    }
  ],
  "active": {
    "steps": [
      { "type": { "at": 0, "count": 3, "startMs": 1000, "everyMs": 100, "recording": "r1" } },
      { "type": { "at": 3, "count": 3, "startMs": 5000, "everyMs": 100, "recording": "r1" } }
    ],
    "queries": [
      { "recording": "r1", "captureNs": 1100000000, "tailNs": 0, "from": [0] },
      { "recording": "r1", "captureNs": 3000000000, "tailNs": 0, "from": [] },
      { "recording": "r1", "captureNs": 5300000000, "tailNs": 200000000, "from": [3] },
      { "recording": "other", "captureNs": 1100000000, "tailNs": 0, "from": [] }
    ]
  }
}
