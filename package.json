{
  "name": "opennote",
  "private": true,
  "type": "module",
  "description": "Open-source note-taking app combining writing, drawing and recording.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "tauri dev",
    "tauri": "tauri",
    "app:dev": "vite --config app/vite.config.ts",
    "app:build": "npm run tokens && vite build --config app/vite.config.ts",
    "app:build:test": "npm run tokens && vite build --config app/vite.config.ts --mode test",
    "app:preview:test": "vite preview --config app/vite.config.ts --mode test",
    "app:test": "vitest run --config app/vitest.config.ts --project unit",
    "test:components": "vitest run --config app/vitest.config.ts --project components",
    "test:ui": "npm run app:build:test && playwright test --config tests/ui/playwright.config.ts",
    "test:ui:update": "npm run app:build:test && playwright test --config tests/ui/playwright.config.ts --update-snapshots",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/smoke/**/*.spec.ts\"",
    "perf:startup": "node tests/perf/startup.ts",
    "perf:typing": "npm run app:build:test && playwright test --config tests/perf/typing/playwright.config.ts",
    "bundle:check": "node app/scripts/check-bundle.ts",
    "app:typecheck": "tsc -p app/tsconfig.json && tsc -p app/scripts/tsconfig.json",
    "tokens": "node app/scripts/build-tokens.ts",
    "tokens:check": "node app/scripts/build-tokens.ts --check",
    "lint": "eslint .",
    "checks": "node checks/cli.ts",
    "checks:all": "node checks/cli.ts --all",
    "checks:fix": "node checks/cli.ts --fix",
    "test:checks": "node --test \"checks/test/**/*.test.ts\"",
    "setup-hooks": "git config core.hooksPath .githooks",
    "typecheck": "tsc -p checks/tsconfig.json && tsc -p docs/design/tsconfig.json && tsc -p spikes/web/tsconfig.json && tsc -p eslint/tsconfig.json && tsc -p tests/tsconfig.json && npm run app:typecheck",
    "format": "prettier --write \"checks/**/*.ts\" \"docs/design/**/*.ts\" \"app/**/*.{ts,tsx,css}\" \"spikes/web/**/*.ts\" \"tests/**/*.ts\" \"eslint/*.{js,ts}\" eslint.config.js",
    "format:check": "prettier --check \"checks/**/*.ts\" \"docs/design/**/*.ts\" \"app/**/*.{ts,tsx,css}\" \"spikes/web/**/*.ts\" \"tests/**/*.ts\" \"eslint/*.{js,ts}\" eslint.config.js",
    "design": "node docs/design/generate.ts",
    "spikes:web": "vite build --config spikes/web/vite.config.ts",
    "spikes": "npm run spikes:web && cargo run --profile spikes -p opennote-spikes --",
    "test": "npm run test:checks && npm run test:lint-rules && npm run app:test",
    "test:lint-rules": "node --test eslint/rules.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.12.0",
    "@testing-library/react": "^16.3.3",
    "@types/markdown-it": "14.2.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "5.0.2",
    "axe-core": "^4.13.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "spdx-license-list": "^6.12.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "webdriverio": "^9.32.0"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.12.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-subscript": "3.31.4",
    "@tiptap/extension-superscript": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "highlight.js": "11.11.2",
    "lowlight": "3.3.0",
    "markdown-it": "15.0.2",
    "perfect-freehand": "^1.2.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "version": "0.1.0-beta.3",
  "license": "Apache-2.0"
}
