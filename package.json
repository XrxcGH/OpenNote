{
  "name": "opennote",
  "private": true,
  "type": "module",
  "description": "Open-source note-taking app combining writing, drawing and recording.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "tauri dev",
    "tauri": "tauri",
    "app:dev": "vite --config app/vite.config.ts",
    "app:build": "npm run tokens && vite build --config app/vite.config.ts",
    "app:test": "vitest run --config app/vite.config.ts",
    "app:typecheck": "tsc -p app/tsconfig.json && tsc -p app/scripts/tsconfig.json",
    "tokens": "node app/scripts/build-tokens.ts",
    "tokens:check": "node app/scripts/build-tokens.ts --check",
    "lint": "eslint .",
    "checks": "node checks/cli.ts",
    "checks:all": "node checks/cli.ts --all",
    "checks:fix": "node checks/cli.ts --fix",
    "test:checks": "node --test \"checks/test/**/*.test.ts\"",
    "setup-hooks": "git config core.hooksPath .githooks",
    "typecheck": "tsc -p checks/tsconfig.json && tsc -p docs/design/tsconfig.json && npm run app:typecheck",
    "format": "prettier --write \"checks/**/*.ts\" \"docs/design/**/*.ts\" \"app/**/*.{ts,tsx,css}\" eslint.config.js",
    "format:check": "prettier --check \"checks/**/*.ts\" \"docs/design/**/*.ts\" \"app/**/*.{ts,tsx,css}\" eslint.config.js",
    "design": "node docs/design/generate.ts",
    "test": "npm run test:checks && npm run app:test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "spdx-license-list": "^6.12.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "version": "0.1.0",
  "license": "Apache-2.0"
}
