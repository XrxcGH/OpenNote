{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window: Tauri's core defaults and each app command by name. No plugin permissions.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-settings-update",
    "allow-settings-reset",
    "allow-state-update",
    "allow-state-flush",
    "allow-window-minimize",
    "allow-window-toggle-maximize",
    "allow-window-close",
    "allow-window-set-title",
    "allow-window-set-caption-layout",
    "allow-window-show-system-menu",
    "allow-window-set-frame-theme",
    "allow-app-first-paint",
    "allow-app-ready",
    "allow-app-exit-ready",
    "allow-perf-mark",
    "allow-log-write",
    "allow-install-status",
    "allow-install-pick-folder",
    "allow-install-check-folder",
    "allow-install-move-to-user-programs",
    "allow-shell-open-external",
    "allow-updater-status",
    "allow-updater-check",
    "allow-updater-download",
    "allow-updater-restart-to-update",
    "allow-updater-skip",
    "allow-updater-unskip",
    "allow-updater-go-back",
    "allow-notes-snapshot-load",
    "allow-notes-snapshot-save",
    "allow-page-open",
    "allow-page-apply",
    "allow-page-undo",
    "allow-page-redo",
    "allow-page-save-now",
    "allow-page-close",
    "allow-history-list",
    "allow-history-open",
    "allow-history-restore",
    "allow-history-restore-blocks",
    "allow-history-name",
    "allow-clipboard-facts",
    "allow-clipboard-read",
    "allow-image-import",
    "allow-image-import-url",
    "allow-image-import-clip",
    "allow-spell-languages",
    "allow-spell-check",
    "allow-spell-suggest",
    "allow-spell-add-word",
    "allow-spell-remove-word",
    "allow-speech-voices",
    "allow-speech-synthesize",
    "allow-print-prepare",
    "allow-print-render",
    "allow-print-close",
    "allow-export-pick-save",
    "allow-export-write",
    "allow-export-open"
  ]
}
