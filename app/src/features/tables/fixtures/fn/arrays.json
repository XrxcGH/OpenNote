{
  "note": "Hand-worked cases for the dynamic array, matrix, and LAMBDA helper functions. An array result is its rows; an error is # and its code.",
  "cases": [
    {
      "formula": "=SEQUENCE(2,2,0,0.5)",
      "expected": [
        [0, 0.5],
        [1, 1.5]
      ],
      "source": "hand",
      "note": "Start at 0 and add 0.5 across each row, then on to the next row."
    },
    {
      "formula": "=SUM(SEQUENCE(10))",
      "expected": 55,
      "source": "hand",
      "note": "1 through 10 add to 10 times 11 over 2."
    },
    {
      "formula": "=SORT(A1:A4,1,-1)",
      "cells": { "A1": 5, "A2": 9, "A3": 1, "A4": 7 },
      "expected": [[9], [7], [5], [1]],
      "source": "hand",
      "note": "Largest first."
    },
    {
      "formula": "=UNIQUE(A1:A5)",
      "cells": { "A1": "pear", "A2": "fig", "A3": "PEAR", "A4": "kiwi", "A5": "fig" },
      "expected": [["pear"], ["fig"], ["kiwi"]],
      "source": "hand",
      "note": "Text matches without regard to case; the first spelling stays."
    },
    {
      "formula": "=FILTER(A1:B3,B1:B3>=10)",
      "cells": { "A1": "a", "B1": 4, "A2": "b", "B2": 10, "A3": "c", "B3": 12 },
      "expected": [
        ["b", 10],
        ["c", 12]
      ],
      "source": "hand",
      "note": "Rows 2 and 3 pass the test."
    },
    {
      "formula": "=SUM(DROP(SEQUENCE(9),-4))",
      "expected": 15,
      "source": "hand",
      "note": "1 through 9 less the last four rows: 1 through 5 add to 15."
    },
    {
      "formula": "=HSTACK({1;2;3},{4;5})",
      "expected": [
        [1, 4],
        [2, 5],
        [3, "#NA"]
      ],
      "source": "hand",
      "note": "The shorter array is padded with #N/A."
    },
    {
      "formula": "=MMULT({1,0,2},{3;4;5})",
      "expected": 13,
      "source": "hand",
      "note": "1 times 3 plus 0 times 4 plus 2 times 5."
    },
    {
      "formula": "=MMULT({1;2},{3,4})",
      "expected": [
        [3, 4],
        [6, 8]
      ],
      "source": "hand",
      "note": "A column times a row is their outer product."
    },
    {
      "formula": "=MDETERM({2,0,0;0,3,0;0,0,4})",
      "expected": 24,
      "source": "hand",
      "note": "A diagonal matrix's determinant is the product of its diagonal."
    },
    {
      "formula": "=MINVERSE({2,0;0,4})",
      "expected": [
        [0.5, 0],
        [0, 0.25]
      ],
      "source": "hand",
      "note": "A diagonal matrix inverts item by item."
    },
    {
      "formula": "=REDUCE(1,SEQUENCE(5),LAMBDA(a,b,a*b))",
      "expected": 120,
      "source": "hand",
      "note": "5 factorial."
    },
    {
      "formula": "=SCAN(\"\",{\"a\",\"b\",\"c\"},LAMBDA(a,b,a&b))",
      "expected": [["a", "ab", "abc"]],
      "source": "hand",
      "note": "Each step joins the next letter."
    },
    {
      "formula": "=BYCOL({1,2;3,4;5,6},LAMBDA(c,SUM(c)))",
      "expected": [[9, 12]],
      "source": "hand",
      "note": "1 plus 3 plus 5, and 2 plus 4 plus 6."
    },
    {
      "formula": "=MAKEARRAY(2,3,LAMBDA(r,c,(r-1)*3+c))",
      "expected": [
        [1, 2, 3],
        [4, 5, 6]
      ],
      "source": "hand",
      "note": "The cells numbered across each row."
    },
    {
      "formula": "=WRAPCOLS(SEQUENCE(1,5),2)",
      "expected": [
        [1, 3, 5],
        [2, 4, "#NA"]
      ],
      "source": "hand",
      "note": "Columns of two, the last one padded."
    },
    {
      "formula": "=TAKE(SORTBY(A1:A3,B1:B3,-1),1)",
      "cells": { "A1": "Ann", "B1": 81, "A2": "Bo", "B2": 95, "A3": "Cy", "B3": 77 },
      "expected": "Bo",
      "source": "hand",
      "note": "The name with the highest score."
    }
  ]
}
