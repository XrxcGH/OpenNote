    { "path": "a/./b", "problem": "dotSegment" },
    { "path": ".", "problem": "dotSegment" },
    { "path": "/a", "problem": "absolute" },
    { "path": "a\\b", "problem": "backslash" },
    { "path": "C:/a.py", "problem": "colon" },
    { "path": "a:b", "problem": "colon" },
    { "path": "a\u0000b", "problem": "control" },
    { "path": "a\tb", "problem": "control" },
    { "path": "a\u007fb", "problem": "control" },
    { "path": "a\u0085b", "problem": "control" },
    { "path": "a?.py", "problem": "reservedChar" },
    { "path": "a*.py", "problem": "reservedChar" },
    { "path": "a<b", "problem": "reservedChar" },
    { "path": "cafe\u0301.py", "problem": "notNfc" },
