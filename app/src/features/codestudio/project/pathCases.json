  "sets": [
    { "paths": ["Main.py", "main.py"], "problem": "duplicate", "at": "main.py" },
    { "paths": ["src/A.py", "SRC/a.py"], "problem": "duplicate", "at": "SRC/a.py" },
    { "paths": ["a", "a/b.py"], "problem": "folderClash", "at": "a/b.py" },
    { "paths": ["lib/x.py", "LIB"], "problem": "folderClash", "at": "LIB" },
    { "paths": ["src/main.py", "src/util.py", "README.md"], "problem": null }
  ]
}
