    { "path": "x.", "problem": "trailingDotOrSpace" },
    { "path": "dir./a.py", "problem": "trailingDotOrSpace" },
    { "path": "CON.py", "problem": "reserved" },
    { "path": "con", "problem": "reserved" },
    { "path": "Aux.tar.gz", "problem": "reserved" },
